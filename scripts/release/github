#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$repo"
if [[ $# != 1 || ! "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Usage: scripts/release/github vMAJOR.MINOR.PATCH" >&2
  exit 2
fi
tag=$1
python3 scripts/release/verify-published "$tag"
if gh release view "$tag" >/dev/null 2>&1; then
  echo "GitHub release $tag already exists."
else
  gh release create "$tag" --verify-tag --title "$tag" --notes ""
fi
